{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicOS",
  "version": "0.1.0",
  "identifier": "com.musicos.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1433",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "musicOS",
        "backgroundColor": "#c8ded9"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/Documents/**",
          "$HOME/Library/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; media-src 'self' asset:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
