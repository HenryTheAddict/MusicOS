{
  "name": "musicos-desktop-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Electron sync companion for MusicOS.",
  "main": "electron/main.js",
  "scripts": {
    "build": "npm run build:desktop",
    "build:desktop": "cargo build --bin musicos-mac --bin musicos-sync --bin musicos-desktop --features desktop-app",
    "check": "cargo check --workspace --features desktop-app",
    "desktop": "cargo run --bin musicos-desktop --features desktop-app",
    "sync:electron": "electron .",
    "sync:electron:dev": "node scripts/run-electron-dev.js",
    "test": "cargo test --workspace --features desktop-app"
  },
  "devDependencies": {
    "electron": "^42.4.1"
  }
}
