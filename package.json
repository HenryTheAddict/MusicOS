{
  "name": "musicos-control-center",
  "version": "0.1.1",
  "private": true,
  "description": "Sketch-based React and Tauri music library with native Rust services.",
  "scripts": {
    "build": "npm run build:ui && node scripts/prepare-desktop.mjs --debug && cargo build -p musicos-tauri",
    "check": "cargo check --workspace --features desktop-app,desktop-audio",
    "check:desktop": "cargo check -p musicos-tauri",
    "desktop": "tauri dev",
    "agent": "cargo run -p musicos-desktop --no-default-features --bin musicos-agent --",
    "cli": "cargo run --bin musicos --features desktop-app,desktop-audio --",
    "test": "cargo test --workspace --features desktop-app,desktop-audio",
    "test:desktop-core": "cargo test -p musicos-desktop --lib --no-default-features",
    "perf:smoke": "node scripts/perf-smoke.js",
    "package": "tauri build",
    "build:legacy": "cargo build -p musicos-desktop --bin musicos-control-center && cargo build --bin musicos-mac --bin musicos-sync --bin musicos-desktop --bin musicos --features desktop-app,desktop-audio",
    "desktop:legacy": "cargo run -p musicos-desktop --bin musicos-control-center",
    "package:legacy": "scripts/package-control-center.sh",
    "dev": "vite --config ui-desktop/vite.config.ts",
    "build:ui": "node scripts/product-config.mjs --check && tsc -p ui-desktop/tsconfig.json && vite build --config ui-desktop/vite.config.ts",
    "tauri": "tauri",
    "test:ui": "vitest run --config ui-desktop/vite.config.ts",
    "test:tauri": "cargo test -p musicos-tauri --lib",
    "test:e2e": "playwright test --config ui-desktop/playwright.config.ts",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "product:check": "node scripts/product-config.mjs --check",
    "product:sync": "node scripts/product-config.mjs --sync"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "figma-squircle": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
