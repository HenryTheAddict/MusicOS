{
  "name": "musicos-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Electron Control Center for MusicOS.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:renderer && npm run build:desktop",
    "build:renderer": "vite build",
    "build:desktop": "cargo build --bin musicos-mac --bin musicos-sync --bin musicos-desktop --bin musicos --features desktop-app,desktop-audio",
    "check": "cargo check --workspace --features desktop-app,desktop-audio",
    "cli": "cargo run --bin musicos --features desktop-app,desktop-audio --",
    "desktop": "npm run sync:electron",
    "preview": "vite preview --host 127.0.0.1",
    "perf:smoke": "powershell -ExecutionPolicy Bypass -File scripts/perf-smoke.ps1",
    "shadcn:init": "npx.cmd --yes shadcn@latest init --preset b1tgXXJFI --template vite --rtl --pointer",
    "sync:electron": "npm run build:renderer && electron .",
    "sync:electron:dev": "node scripts/run-electron-dev.js",
    "test": "cargo test --workspace --features desktop-app,desktop-audio",
    "test:renderer": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:linux": "electron-builder --linux appimage"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.musicos.controlcenter",
    "productName": "MusicOS Control Center",
    "linux": {
      "target": "AppImage",
      "category": "Audio"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "electron/renderer-vite/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
