#!/usr/bin/env bash
set -euo pipefail

args=()
skip_next=0
for arg in "$@"; do
  if (( skip_next )); then
    skip_next=0
    continue
  fi

  case "$arg" in
    --target=aarch64-unknown-linux-gnu|-target=aarch64-unknown-linux-gnu)
      ;;
    --target|-target)
      skip_next=1
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

exec zig cc -target aarch64-linux-gnu "${args[@]}"
