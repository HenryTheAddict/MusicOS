BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MUSICOS_PATH)/board/qemu/linux.fragment"
BR2_PACKAGE_MUSICOS_INIT=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_SQLITE=y
BR2_TARGET_ROOTFS_EXT2=y
